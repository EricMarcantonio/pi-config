{
  "mcpServers": {
    "excalidraw": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--pull",
        "never",
        "--network",
        "pi-services",
        "-e",
        "EXPRESS_SERVER_URL=http://pi-excalidraw-canvas:3000",
        "-e",
        "ENABLE_CANVAS_SYNC=true",
        "pi-excalidraw-mcp:local"
      ]
    }
  }
}
