{
  "mcpServers": {
    "home-assistant": {
      "command": "/Users/eric/.local/bin/ha-mcp-proxy"
    },
    "freecad": {
      "command": "uvx",
      "args": [
        "freecad-mcp"
      ]
    },
    "homedepot": {
      "command": "node",
      "args": [
        "/Users/eric/.pi/agent/mcp-servers/mcp_homedepot/dist/index.js"
      ],
      "env": {
        "HD_DEFAULT_STORE": "7011"
      }
    },
    "blender": {
      "command": "uv",
      "args": [
        "--directory",
        "/Users/eric/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ]
    },
    "excalidraw": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--pull",
        "never",
        "--network",
        "pi-services",
        "-e",
        "EXPRESS_SERVER_URL=http://pi-excalidraw-canvas:3000",
        "-e",
        "ENABLE_CANVAS_SYNC=true",
        "pi-excalidraw-mcp:local"
      ]
    },
    "wordcraft": {
      "command": "/Users/eric/.local/bin/wordcraft-cli",
      "args": [
        "mcp"
      ]
    },
    "figcraft": {
      "command": "/Users/eric/.local/bin/figcraft-cli",
      "args": [
        "mcp"
      ]
    },
    "rea": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.7.0",
        "mcp"
      ],
      "env": {
        "HOPPER_LAUNCHER_PATH": "/Users/eric/Applications/Hopper Disassembler.app/Contents/MacOS/hopper"
      }
    }
  }
}
